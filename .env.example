# YQMetals 本地开发环境变量模板
# 使用方法：复制本文件为 .env（.env 已被 .gitignore 排除，不会提交），
#          或在操作系统层面以同名变量注入。生产环境必须走服务器环境变量，禁止使用 .env。

# ---- 数据库 ----
YQ_DB_URL=jdbc:mysql://your-db-host:3306/yqmetals?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
YQ_DB_USERNAME=root
YQ_DB_PASSWORD=填写你的数据库密码

# ---- JWT（必须设置，且长度建议 32 字节以上，base64 编码）----
YQ_JWT_SECRET=填写你的 JWT 密钥

# ---- 部署 ----
YQ_UPLOAD_DIR=/var/lib/yqmetals/uploads
BASE_URL=https://www.yqwiremesh.com

# ---- Spring 激活 profile（dev / prod）----
SPRING_PROFILES_ACTIVE=dev
