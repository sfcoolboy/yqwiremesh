# Yuanquan Metals (yqwiremesh.com) 生产环境变量模板
# 用途：docker compose 启动时从同目录的 .env 自动读取这些变量。
# 用法：
#   1. 将本文件复制为同一目录下的 .env（.env 已被 .gitignore 排除，严禁提交到 Git）。
#   2. 按下面说明填入真实值。
#   3. 在服务器上执行 docker compose up -d。
#
# 生产安全红线：
#   - .env 只能存在于服务器上，永远不要 commit、不要发到群里、不要贴到工单。
#   - 密码和 JWT 密钥用 openssl 或密码管理器生成，不要手写弱口令。

# ---------------- 数据库（MySQL 8.0）----------------
# root 密码，compose 用它初始化实例并做健康检查
MYSQL_ROOT_PASSWORD=请填入至少 16 位的随机密码
# 业务账号：Spring Boot 用此账号连接，权限仅限 yqmetals 库
MYSQL_USER=yq_app
# 业务账号密码
MYSQL_PASSWORD=请填入至少 16 位的随机密码

# ---------------- Spring Boot / 业务----------------
# 必须激活 prod profile，否则 CORS / 上传目录 / 日志路径会回退到开发期默认值
SPRING_PROFILES_ACTIVE=prod
# 对外正式域名，必须与实际访问域名一致（影响页面生成的链接、邮件里的回链）
BASE_URL=https://www.yqwiremesh.com
# 同上，暴露给前端 Vite 构建（必须以 VITE_ 开头才会注入 import.meta.env）
VITE_BASE_URL=https://www.yqwiremesh.com
# JWT 密钥：建议 openssl rand -base64 48 生成，长度 >= 32 字节
YQ_JWT_SECRET=请填入你的 JWT 密钥
# JVM 内存；2vCPU/4GiB 机型给 512m~1g 即可，不要超过容器内存的 60%
YQ_JAVA_OPTS=-Xmx512m

# ---------------- Docker 镜像（CI/本地构建用，可选）----------------
DOCKER_IMAGE=yqmetals/backend
# 镜像标签；CI 推 main 分支时打 latest，发版时建议打 v1.0.0 这类固定标签
TAG=latest
